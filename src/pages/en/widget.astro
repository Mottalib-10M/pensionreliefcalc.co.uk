---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/pension-tax-relief-calculator/" title="Pension tax relief calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the pension tax relief calculator on your website" description="Add the pension tax relief calculator to your website for free: one iframe, relief at source, net pay and salary sacrifice for 2026/27, Scotland included, no sign-up and no cookies." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the pension tax relief calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a union's members page, an employer's benefits site, a money guidance charity or a personal finance blog: readers type their salary and contribution and see what it costs under each method, with the relief to claim.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible, use it as it is and without warranty, and do not present it as advice from your organisation. When the rules are updated here, the embedded calculator follows.</p>
    <p>Nothing your readers type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/pension-tax-relief-calculator/" title="Pension tax relief calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>

---
/** Renders one tool with its page defaults: a full calculator (`tool:<spec>`) or a mini-calculator (`mini:<spec>`). */
import Calc from './calc/Calc';
import MiniSim from './calc/MiniSim';
import { route } from '../i18n/routes';
import { getSpec } from '../lib/mini-specs';
import { getTool } from '../lib/tool-specs';
import type { ToolDef } from '../lib/guide-types';
interface Props { tool: ToolDef; primary?: boolean; idPrefix?: string }
const { tool, primary = false, idPrefix } = Astro.props;
const props = (tool.props ?? {}) as Record<string, any>;
const methodHref = route('method', 'en');
const kind = tool.kind;
const full = kind.startsWith('tool:') ? kind.slice(5) : null;
const mini = kind.startsWith('mini:') ? kind.slice(5) : null;
const spec = mini ? getSpec(mini) : null;
const href = spec?.ctaPage ? route(spec.ctaPage, 'en') : undefined;
const note = full ? getTool(full).formNote : undefined;
const noteHref = note ? `${route(note.page, 'en')}${note.anchor ? `#${note.anchor}` : ''}` : undefined;
const act = full ? getTool(full).action : undefined;
const actionHref = act ? `${route(act.page, 'en')}${act.anchor ? `#${act.anchor}` : ''}` : undefined;
const numDefaults: Record<string, number> = {};
for (const [k, v] of Object.entries(props)) if (typeof v === 'number') numDefaults[k] = v;
---
{full && <Calc client:load kind={full} defaults={numDefaults} methodHref={methodHref} idPrefix={idPrefix ?? (primary ? 'c' : 'k')} noteHref={noteHref} actionHref={actionHref} />}
{mini && <MiniSim client:load kind={mini} href={href} defaults={numDefaults} primary={primary} idPrefix={idPrefix ?? (primary ? 'p' : 'm')} />}
